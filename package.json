{
  "name": "codex-pr-review",
  "version": "1.0.0",
  "description": "Bring-your-own-key GitHub Action that reviews pull requests with OpenAI Codex, Anthropic Claude, or Google Gemini — provider and model both selectable per run.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "clean": "rm -rf dist lib",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify-dist": "npm run build && git diff --exit-code --stat dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.123.0",
    "@google/genai": "^2.21.0",
    "openai": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
