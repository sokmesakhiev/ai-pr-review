# Copy to .env for local testing only. Never commit real values.
# Bring-your-own-key model — set the key(s) for whichever provider(s) you use.
# Only the one matching your chosen model needs to actually be set.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Optional: GitHub token with `pull-requests: write` (Actions supplies this
# automatically via ${{ github.token }} — only needed for local test runs).
GITHUB_TOKEN=ghp_...

# Optional local test target (owner/repo#pr_number style is parsed by scripts/local-run.ts if added).
GITHUB_REPOSITORY=owner/repo
PR_NUMBER=1

# Optional: overrides the model without editing workflow YAML. The provider
# (openai | anthropic | gemini) is inferred from the model id's prefix.
CODEX_MODEL=gpt-5.1-codex
